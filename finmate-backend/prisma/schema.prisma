generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   Role                    @default(USER)
  plan                   Plan                    @default(FREE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  budgets                Budget[]
  expenseShares          GroupExpenseShare[]
  expensesPaid           GroupExpense[]          @relation("ExpensesPaid")
  memberships            GroupMember[]
  groupsCreated          Group[]                 @relation("GroupsCreated")
  notificationPreference NotificationPreference?
  notifications          Notification[]
  receipts               Receipt[]
  refreshTokens          RefreshToken[]
  transactions           Transaction[]

  @@map("users")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  priority    String
  type        String
  action      Json?
  dedupeKey   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  enabled       Boolean  @default(true)
  budget        Boolean  @default(true)
  forecasts     Boolean  @default(true)
  subscriptions Boolean  @default(true)
  savings       Boolean  @default(true)
  aiAdvisor     Boolean  @default(true)
  achievements  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Transaction {
  id             String          @id @default(uuid())
  userId         String
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  category       String
  note           String?
  date           DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  groupExpenseId String?
  receiptId      String?         @unique
  groupExpense   GroupExpense?   @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  receipt        Receipt?        @relation("ReceiptTransaction", fields: [receiptId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

model Group {
  id          String         @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime       @default(now())
  expenses    GroupExpense[]
  members     GroupMember[]
  createdBy   User           @relation("GroupsCreated", fields: [createdById], references: [id])

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupExpense {
  id                   String              @id @default(uuid())
  groupId              String
  paidById             String
  description          String
  amount               Decimal             @db.Decimal(12, 2)
  date                 DateTime            @default(now())
  createdAt            DateTime            @default(now())
  shares               GroupExpenseShare[]
  group                Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy               User                @relation("ExpensesPaid", fields: [paidById], references: [id])
  personalTransactions Transaction[]

  @@index([groupId])
  @@map("group_expenses")
}

model GroupExpenseShare {
  id             String       @id @default(uuid())
  groupExpenseId String
  userId         String
  shareAmount    Decimal      @db.Decimal(12, 2)
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupExpenseId, userId])
  @@map("group_expense_shares")
}

model Receipt {
  id          String       @id @default(uuid())
  userId      String
  imageUrl    String
  vendor      String?
  receiptDate DateTime?
  totalAmount Decimal      @db.Decimal(12, 2)
  taxAmount   Decimal?     @db.Decimal(12, 2)
  tipAmount   Decimal?     @db.Decimal(12, 2)
  items       Json?
  rawOcrText  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publicId    String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("ReceiptTransaction")

  @@index([userId, receiptDate])
  @@map("receipts")
}

enum Plan {
  FREE
  PREMIUM
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}
