NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://finmate:finmate@localhost:5432/finmate?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Required only for receipt upload/OCR:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set true only when API documentation should be public in production.
ENABLE_API_DOCS=false
